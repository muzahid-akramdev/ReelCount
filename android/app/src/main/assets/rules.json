{
  "schemaVersion": 1,
  "global": {
    "debounceMs": 600,
    "countOnViewerEnter": true,
    "countBackwardSwipes": false,
    "backwardHeuristicWindowMs": 2000,
    "maxGapSeconds": 180,
    "maxTreeDepth": 18
  },
  "apps": [
    {
      "id": "instagram",
      "packageName": "com.instagram.android",
      "enabled": true,
      "viewer": {
        "minScore": 4,
        "signals": [
          {
            "source": "viewId",
            "op": "regex",
            "value": "(?i)clips_viewer|clips_media_component|clips_video",
            "score": 4,
            "minHeightRatio": 0.55
          },
          {
            "source": "contentDescription",
            "op": "regex",
            "value": "(?i)(\\breels?\\b|রিলস?)",
            "score": 4,
            "minHeightRatio": 0.75
          },
          {
            "source": "className",
            "op": "regex",
            "value": "(?i)(Reel|Clips)[A-Za-z0-9_.]*Activity",
            "score": 4
          }
        ],
        "blockers": [
          {
            "source": "viewId",
            "op": "regex",
            "value": "(?i)direct_inbox|reel_viewer_root|reel_viewer_media|stories_tray|story_viewer"
          }
        ]
      },
      "identity": {
        "extractors": [
          {
            "kind": "pagerIndex",
            "source": "viewId",
            "op": "regex",
            "value": "(?i)clips_viewer|view_pager"
          },
          {
            "kind": "structuralHash",
            "include": ["viewId"]
          }
        ]
      }
    },
    {
      "id": "youtube",
      "packageName": "com.google.android.youtube",
      "enabled": true,
      "viewer": {
        "minScore": 3,
        "signals": [
          {
            "source": "viewId",
            "op": "regex",
            "value": "(?i)reel_|shorts_",
            "score": 3,
            "minHeightRatio": 0.7
          },
          {
            "source": "contentDescription",
            "op": "regex",
            "value": "(?i)(\\bshorts?\\b|শর্টস)",
            "score": 3,
            "minHeightRatio": 0.75
          },
          {
            "source": "className",
            "op": "regex",
            "value": "(?i)Shorts[A-Za-z0-9_.]*Activity",
            "score": 4
          }
        ],
        "blockers": [
          {
            "source": "viewId",
            "op": "contains",
            "value": "watch_player"
          }
        ]
      },
      "identity": {
        "extractors": [
          {
            "kind": "pagerIndex",
            "source": "viewId",
            "op": "regex",
            "value": "(?i)reel_|shorts_"
          },
          {
            "kind": "structuralHash",
            "include": ["viewId"]
          }
        ]
      }
    },
    {
      "id": "facebook",
      "packageName": "com.facebook.katana",
      "enabled": true,
      "viewer": {
        "minScore": 3,
        "signals": [
          {
            "source": "viewId",
            "op": "regex",
            "value": "(?i)reel|fb_shorts|shorts_viewer",
            "score": 3,
            "minHeightRatio": 0.72
          },
          {
            "source": "contentDescription",
            "op": "regex",
            "value": "(?i)(\\breels?\\b|রিলস?)",
            "score": 3,
            "minHeightRatio": 0.75
          },
          {
            "source": "className",
            "op": "regex",
            "value": "(?i)(Reel|Clips|Shorts)[A-Za-z0-9_.]*Activity",
            "score": 4
          }
        ],
        "blockers": [
          {
            "source": "viewId",
            "op": "regex",
            "value": "(?i)stories_tray|story_viewer"
          }
        ]
      },
      "identity": {
        "extractors": [
          {
            "kind": "pagerIndex",
            "source": "className",
            "op": "regex",
            "value": "(?i)ViewPager|RecyclerView"
          },
          {
            "kind": "structuralHash",
            "include": ["viewId"]
          }
        ]
      }
    },
    {
      "id": "facebook_lite",
      "packageName": "com.facebook.lite",
      "enabled": true,
      "viewer": {
        "minScore": 3,
        "signals": [
          {
            "source": "viewId",
            "op": "regex",
            "value": "(?i)reel|shorts|clips|video_fullscreen|fullscreen_video",
            "score": 3,
            "minHeightRatio": 0.6
          },
          {
            "source": "contentDescription",
            "op": "regex",
            "value": "(?i)(\\breels?\\b|\\bshorts?\\b|রিলস?|শর্টস)",
            "score": 3,
            "minHeightRatio": 0.6
          },
          {
            "source": "className",
            "op": "regex",
            "value": "(?i)(Reel|Clips|Shorts|Watch)[A-Za-z0-9_.]*Activity",
            "score": 4
          }
        ],
        "blockers": []
      },
      "identity": {
        "extractors": [
          {
            "kind": "pagerIndex",
            "source": "className",
            "op": "regex",
            "value": "(?i)ViewPager|RecyclerView"
          },
          {
            "kind": "structuralHash",
            "include": ["viewId", "className"]
          }
        ]
      }
    }
  ]
}
