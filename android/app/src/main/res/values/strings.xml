    <string name="app_name">ReelCount</string>
    <string name="accessibility_description">Counts short videos you open in Facebook, Instagram and YouTube. ReelCount reads view ids only. It does not read or store captions, usernames or links.</string>
    <string name="nav_home">Today</string>
    <string name="nav_history">History</string>
