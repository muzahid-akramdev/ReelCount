    <string name="onboarding_title">What ReelCount does</string>
    <string name="onboarding_body">A floating counter appears while a Reels or Shorts viewer is open. The number is how many short videos you started today.</string>
    <string name="onboarding_collect_title">What is saved on this phone</string>
    <string name="onboarding_collect_body">The app name, the time of each count, and the daily total. Nothing else.</string>
    <string name="onboarding_not_title">What is never collected</string>
    <string name="onboarding_not_body">Captions, comments, usernames, profile links and video addresses are not read into storage, not logged and not uploaded. There are no ads and no analytics.</string>
    <string name="onboarding_restricted_title">Android 13 and newer, sideloaded install</string>
    <string name="onboarding_restricted_body">Open App info, tap the three-dot menu, choose Allow restricted settings, then turn on ReelCount under Accessibility.</string>
    <string name="onboarding_battery_title">Battery</string>
    <string name="onboarding_battery_body">Exclude ReelCount from battery optimisation so the counter keeps running.</string>
    <string name="onboarding_oem">Xiaomi, Oppo, Vivo and some Samsung phones also need Autostart turned on. The system does not let an app do that for you.</string>
