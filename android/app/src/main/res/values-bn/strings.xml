    <string name="onboarding_title">ReelCount কী করে</string>
    <string name="onboarding_body">Reels বা Shorts খোলা থাকলে একটা ভাসমান কাউন্টার দেখায়। সংখ্যাটা হলো আজ আপনি কতগুলো ছোট ভিডিও শুরু করেছেন।</string>
    <string name="onboarding_collect_title">এই ফোনে যা সেভ হয়</string>
    <string name="onboarding_collect_body">অ্যাপের নাম, প্রতিটি গণনার সময়, আর দিনের মোট। এর বেশি কিছু না।</string>
    <string name="onboarding_not_title">যা কখনো সংগ্রহ হয় না</string>
    <string name="onboarding_not_body">ক্যাপশন, মন্তব্য, ইউজারনেম, প্রোফাইল লিংক ও ভিডিওর ঠিকানা স্টোরেজে যায় না, লগ হয় না, আপলোডও হয় না। বিজ্ঞাপন বা অ্যানালিটিক্স নেই।</string>
    <string name="onboarding_restricted_title">Android 13 বা নতুন, সাইডলোড করলে</string>
    <string name="onboarding_restricted_body">অ্যাপের তথ্য খুলুন, তিন বিন্দুর মেনুতে Allow restricted settings বেছে নিন, তারপর Accessibility-তে ReelCount চালু করুন।</string>
    <string name="onboarding_battery_title">ব্যাটারি</string>
    <string name="onboarding_battery_body">কাউন্টার চালু রাখতে ReelCount-কে ব্যাটারি অপটিমাইজেশন থেকে বাদ দিন।</string>
    <string name="onboarding_oem">Xiaomi, Oppo, Vivo ও কিছু Samsung ফোনে Autostart-ও চালু করতে হয়। সেটা অ্যাপ নিজে করতে পারে না।</string>
