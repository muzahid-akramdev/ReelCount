    <string name="app_name">ReelCount</string>
    <string name="accessibility_description">Facebook, Instagram ও YouTube-এ আপনি যতগুলো ছোট ভিডিও খোলেন, সেই সংখ্যা গোনে। ReelCount শুধু ভিউ আইডি দেখে। ক্যাপশন, ইউজারনেম বা লিংক পড়ে না, সেভও করে না।</string>
